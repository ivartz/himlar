#
# git repo base URIs
#
github = 'https://github.com/'
#local  = 'iaas@git.norcams.org:'

#
# profile::openstack::*
#
mod 'glance',       :ref => '2023.1-eom',                 :git => github + 'openstack/puppet-glance'
mod 'cinder',       :ref => '2023.1-eom',                 :git => github + 'openstack/puppet-cinder'
mod 'neutron',      :ref => '2023.1-eom',                 :git => github + 'openstack/puppet-neutron'
mod 'nova',         :ref => '2023.1-eom',                 :git => github + 'openstack/puppet-nova'
mod 'horizon',      :ref => '2023.1-eom',                 :git => github + 'openstack/puppet-horizon'
mod 'gnocchi',      :ref => '2023.1-eom',                 :git => github + 'openstack/puppet-gnocchi'
mod 'keystone',     :ref => '2023.1-eom',                 :git => github + 'openstack/puppet-keystone'
mod 'ceilometer',   :ref => '2023.1-eom',                 :git => github + 'openstack/puppet-ceilometer'
mod 'designate',    :ref => '2023.1-eom',                 :git => github + 'openstack/puppet-designate'
mod 'cloudkitty',   :ref => '2023.1-eom',                 :git => github + 'openstack/puppet-cloudkitty'
mod 'placement',    :ref => '2023.1-eom',                 :git => github + 'openstack/puppet-placement'
mod 'oslo',         :ref => '2023.1-eom',                 :git => github + 'openstack/puppet-oslo'
#mod 'openstacklib', :ref => 'zed-eom',                    :git => github + 'openstack/puppet-openstacklib'
mod 'openstacklib', :ref => 'zed',                        :git => github + 'norcams/puppet-openstacklib'

mod 'memcached',    :ref => 'v3.4.0',                     :git => github + 'saz/puppet-memcached'
mod 'rsync',        :ref => '1.2.0',                      :git => github + 'puppetlabs/puppetlabs-rsync'
mod 'mysql',        :ref => 'v13.0.0',                    :git => github + 'puppetlabs/puppetlabs-mysql'
mod 'galera_arbitrator', :ref => '2.0.2',                 :git => github + 'jadestorm/puppet-galera_arbitrator'

# new network module for el9
mod 'network',      :ref => 'master',                     :git => github + 'raykrist/puppet-network'

# modules to upgrade for el9
mod 'yumrepo_core', :ref => 'v1.2.0',                     :git => github + 'puppetlabs/puppetlabs-yumrepo_core'

# Core dependencies for OpenStack modules
mod 'stdlib',       :ref => 'v8.1.0',                     :git => github + 'puppetlabs/puppetlabs-stdlib'
mod 'concat',       :ref => 'v7.1.0',                     :git => github + 'puppetlabs/puppetlabs-concat'
mod 'inifile',      :ref => 'v5.2.0',                     :git => github + 'puppetlabs/puppetlabs-inifile'
mod 'extlib',       :ref => 'v6.2.0',                     :git => github + 'voxpupuli/puppet-extlib.git'
mod 'translate',    :ref => 'v2.2.0',                     :git => github + 'puppetlabs/puppetlabs-translate'
mod 'apache',       :ref => 'v8.3.0',                     :git => github + 'puppetlabs/puppetlabs-apache'
mod 'systemd',     :ref => 'v3.2.0',                      :git => github + 'voxpupuli/puppet-systemd'
mod 'archive',     :ref => 'v2.2.0',                      :git => github + 'voxpupuli/puppet-archive'
mod 'rabbitmq',    :ref => 'v11.1.0',                     :git => github + 'voxpupuli/puppet-rabbitmq'
mod 'augeasproviders_core', :ref => '2.1.4',             :git => github + 'hercules-team/augeasproviders_core'
mod 'augeasproviders_shellvar', :ref => '2.2.2',         :git => github + 'hercules-team/augeasproviders_shellvar'

# Additional modules required by profile classes in vagrant/antelope
mod 'openssl',  :ref => '1.10.0',   :git => github + 'camptocamp/puppet-openssl'
mod 'firewall', :ref => 'v3.4.0',   :git => github + 'puppetlabs/puppetlabs-firewall'
mod 'calico',   :ref => 'v1.0.15',  :git => github + 'norcams/puppet-calico'
mod 'bird',     :ref => 'v4.1.0',   :git => github + 'voxpupuli/puppet-bird'
mod 'etcd',     :ref => '1.12.3',   :git => github + 'puppet-etcd/puppet-etcd'
mod 'sysctl',   :ref => 'v0.0.11',  :git => github + 'duritong/puppet-sysctl'
mod 'kmod',     :ref => 'v3.0.0',   :git => github + 'voxpupuli/puppet-kmod'
mod 'ceph',     :ref => '5.0.0',    :git => github + 'openstack/puppet-ceph'
mod 'named_interfaces', :ref => 'v1.0.1',   :git => github + 'norcams/puppet-named_interfaces'
mod 'selinux',   :ref => 'v3.4.0',   :git => github + 'voxpupuli/puppet-selinux'
